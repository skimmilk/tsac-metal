cmake_minimum_required(VERSION 3.20)
file(LOCK "${DESTINATION}/.tsac-stage.lock" GUARD PROCESS TIMEOUT 120)
file(LOCK "${ROOT}/generation.lock" GUARD PROCESS TIMEOUT 120)
include("${ROOT}/active-generation.cmake")
include("${TSAC_GENERATION_DIRECTORY}/weights-manifest.cmake")
file(SIZE "${BINARY}" binary_bytes)
math(EXPR total "${binary_bytes}+${TSAC_WEIGHT_BYTES}")
if(total GREATER BUDGET)
  message(FATAL_ERROR "Staged distribution exceeds ${BUDGET} bytes: ${total}")
endif()
set(old_files)
if(EXISTS "${DESTINATION}/.tsac-staged-files.cmake")
  include("${DESTINATION}/.tsac-staged-files.cmake")
  set(old_files ${TSAC_STAGED_FILES})
endif()
if(EXISTS "${DESTINATION}/.tsac-staging-transaction.cmake")
  include("${DESTINATION}/.tsac-staging-transaction.cmake")
  list(APPEND old_files ${TSAC_TRANSACTION_FILES})
endif()
set(new_files ${TSAC_WEIGHT_FILES})
file(WRITE "${DESTINATION}/.tsac-staging-transaction.cmake"
  "set(TSAC_TRANSACTION_FILES \"${old_files};${new_files}\")\n")
foreach(name IN LISTS new_files)
  set(copy TRUE)
  if(EXISTS "${DESTINATION}/${name}")
    file(SIZE "${DESTINATION}/${name}" present_size)
    if(present_size EQUAL TSAC_WEIGHT_SIZE_${name})
      set(copy FALSE)
    endif()
  endif()
  if(copy)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${TSAC_GENERATION_DIRECTORY}/${name}"
      "${DESTINATION}/.${name}.tmp" COMMAND_ERROR_IS_FATAL ANY)
    file(RENAME "${DESTINATION}/.${name}.tmp" "${DESTINATION}/${name}")
  endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${BINARY}" "${DESTINATION}/.tsac.tmp"
  COMMAND_ERROR_IS_FATAL ANY)
file(RENAME "${DESTINATION}/.tsac.tmp" "${DESTINATION}/tsac")
file(WRITE "${DESTINATION}/.tsac-staged-files.cmake.tmp"
  "set(TSAC_STAGED_FILES \"${new_files}\")\n")
file(RENAME "${DESTINATION}/.tsac-staged-files.cmake.tmp" "${DESTINATION}/.tsac-staged-files.cmake")
foreach(name IN LISTS old_files)
  if(NOT name IN_LIST new_files AND name MATCHES "^tsac-[a-z0-9-]+[.]weights$")
    file(REMOVE "${DESTINATION}/${name}")
  endif()
endforeach()
file(REMOVE "${DESTINATION}/.tsac-staging-transaction.cmake")
message(STATUS "Staged tsac and weights: ${total} bytes")
