if(NOT EXISTS "${MANIFEST}")
  message(FATAL_ERROR "No installation manifest: ${MANIFEST}")
endif()
file(STRINGS "${MANIFEST}" installed)
foreach(path IN LISTS installed)
  if(path MATCHES "/[.]tsac-installed-weights[.]cmake$" AND EXISTS "$ENV{DESTDIR}${path}")
    include("$ENV{DESTDIR}${path}")
    get_filename_component(directory "$ENV{DESTDIR}${path}" DIRECTORY)
    foreach(name IN LISTS TSAC_INSTALLED_WEIGHT_FILES)
      if(name MATCHES "^tsac-[a-z0-9-]+[.]weights$")
        file(REMOVE "${directory}/${name}")
      endif()
    endforeach()
  endif()
endforeach()
foreach(path IN LISTS installed)
  file(REMOVE "$ENV{DESTDIR}${path}")
endforeach()
