cmake_minimum_required(VERSION 3.20)
file(LOCK "${DESTINATION}/.tsac-stage.lock" GUARD PROCESS TIMEOUT 120)
set(owned)
if(EXISTS "${DESTINATION}/.tsac-staged-files.cmake")
  include("${DESTINATION}/.tsac-staged-files.cmake")
  list(APPEND owned ${TSAC_STAGED_FILES})
endif()
if(EXISTS "${DESTINATION}/.tsac-staging-transaction.cmake")
  include("${DESTINATION}/.tsac-staging-transaction.cmake")
  foreach(name IN LISTS TSAC_TRANSACTION_FILES)
    if(name MATCHES "^tsac-[a-z0-9-]+[.]weights$")
      file(REMOVE "${DESTINATION}/.${name}.tmp")
    endif()
  endforeach()
  # An interrupted publication may have replaced the executable already.
  # Keep both generations until a successful stage, or explicit clean.
  if(ALL)
    list(APPEND owned ${TSAC_TRANSACTION_FILES})
  endif()
endif()
if(ALL)
  foreach(name IN LISTS owned)
    if(name MATCHES "^tsac-[a-z0-9-]+[.]weights$")
      file(REMOVE "${DESTINATION}/${name}")
    endif()
  endforeach()
  file(REMOVE "${DESTINATION}/tsac" "${DESTINATION}/.tsac-staged-files.cmake"
    "${DESTINATION}/.tsac-staging-transaction.cmake" "${DESTINATION}/.tsac.tmp")
endif()
if(DEFINED ROOT AND EXISTS "${ROOT}")
  file(LOCK "${ROOT}/generation.lock" GUARD PROCESS TIMEOUT 120)
  set(active "")
  if(EXISTS "${ROOT}/active-generation.cmake")
    include("${ROOT}/active-generation.cmake")
    set(active "${TSAC_GENERATION_DIRECTORY}")
  endif()
  file(GLOB generations LIST_DIRECTORIES TRUE "${ROOT}/generations/*" "${ROOT}/generations/.tmp-*")
  foreach(path IN LISTS generations)
    if(ALL OR NOT path STREQUAL active)
      file(REMOVE_RECURSE "${path}")
    endif()
  endforeach()
  if(ALL)
    file(REMOVE "${ROOT}/active-generation.cmake")
  endif()
endif()
