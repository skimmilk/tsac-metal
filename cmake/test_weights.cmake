cmake_minimum_required(VERSION 3.20)
include("${ROOT}/active-generation.cmake")
set(arguments "${TSAC_GENERATION_DIRECTORY}")
if(ORIGINALS)
  list(APPEND arguments "${ORIGINALS}")
endif()
if(EXTRA_ARGUMENTS)
  list(APPEND arguments ${EXTRA_ARGUMENTS})
endif()
execute_process(COMMAND "${PROGRAM}" ${arguments}
  RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Packed weight checks failed: ${result}")
endif()
