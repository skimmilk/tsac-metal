cmake_minimum_required(VERSION 3.20)
file(MAKE_DIRECTORY "${ROOT}" "${GENERATED}" "${ROOT}/generations")
file(LOCK "${ROOT}/generation.lock" GUARD PROCESS TIMEOUT 120)
set(inputs dac_mono_q8.bin dac_stereo_q8.bin tsac_mono_q8.bin tsac_stereo_q8.bin)
set(missing FALSE)
foreach(name IN LISTS inputs)
  if(NOT EXISTS "${MODELS}/${name}")
    set(missing TRUE)
  endif()
endforeach()
if(missing)
  if(NOT DOWNLOAD)
    message(FATAL_ERROR "Original model inputs missing from ${MODELS}; enable TSAC_DOWNLOAD_MODELS")
  endif()
  execute_process(COMMAND sh "${SOURCE_ROOT}/download-models.sh" "${MODELS}" COMMAND_ERROR_IS_FATAL ANY)
endif()
file(SHA256 "${PACKER}" packer_hash)
set(identity "format=tsac-compact317-v1\npacker=${packer_hash}\n")
if(TRANSFORMER)
  set(transformer_flag 1)
else()
  set(transformer_flag 0)
endif()
string(APPEND identity "transformer=${transformer_flag}\n")
foreach(name IN LISTS inputs)
  file(SHA256 "${MODELS}/${name}" hash)
  string(APPEND identity "${name}=${hash}\n")
endforeach()
string(SHA256 full_id "${identity}")
string(SUBSTRING "${full_id}" 0 16 pack_id)
set(generation "${ROOT}/generations/${pack_id}")
set(valid TRUE)
if(NOT EXISTS "${generation}/weights-manifest.cmake" OR NOT EXISTS "${generation}/identity.txt")
  set(valid FALSE)
else()
  file(READ "${generation}/identity.txt" existing_identity)
  if(NOT existing_identity STREQUAL identity)
    message(FATAL_ERROR "Weight generation ID collision: ${pack_id}")
  endif()
  include("${generation}/weights-manifest.cmake")
  foreach(name IN LISTS TSAC_WEIGHT_FILES)
    if(NOT EXISTS "${generation}/${name}")
      set(valid FALSE)
    else()
      file(SIZE "${generation}/${name}" bytes)
      if(NOT bytes EQUAL TSAC_WEIGHT_SIZE_${name})
        set(valid FALSE)
      endif()
    endif()
  endforeach()
  if(NOT EXISTS "${generation}/adapter_offsets.hpp")
    set(valid FALSE)
  endif()
endif()
if(NOT valid)
  set(temporary "${ROOT}/generations/.tmp-${pack_id}")
  file(REMOVE_RECURSE "${temporary}")
  execute_process(COMMAND "${PACKER}" "${MODELS}" "${temporary}" "${pack_id}" "${transformer_flag}"
    RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    file(REMOVE_RECURSE "${temporary}")
    message(FATAL_ERROR "Weight packing failed: ${result}")
  endif()
  file(WRITE "${temporary}/identity.txt" "${identity}")
  # A corrupted/missing generation can be regenerated under the same identity.
  # Published files are immutable; readers already retain their mappings.
  if(EXISTS "${generation}")
    file(REMOVE_RECURSE "${generation}")
  endif()
  file(RENAME "${temporary}" "${generation}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different
  "${generation}/adapter_offsets.hpp" "${GENERATED}/adapter_offsets.hpp"
  COMMAND_ERROR_IS_FATAL ANY)
# Remove the obsolete bridge when upgrading an existing build directory.
file(REMOVE "${GENERATED}/weight_offsets.hpp")
file(WRITE "${ROOT}/active-generation.cmake.tmp" "set(TSAC_GENERATION_DIRECTORY \"${generation}\")\n")
file(RENAME "${ROOT}/active-generation.cmake.tmp" "${ROOT}/active-generation.cmake")
